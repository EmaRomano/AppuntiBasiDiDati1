@startuml
skinparam classAttributeIconSize 0
left to right direction 

class Fornitore {
    - id: Long
    - nome: String
}

class Prodotto {
    - id: Long
    - descrizione: String
}

class Progetto {
    - id: Long
    - denominazione: String
}

' Il rombo rappresenta l'associazione ternaria n-aria
diamond " " as TernaryDiamond

Fornitore -- TernaryDiamond
Prodotto -- TernaryDiamond
Progetto -- TernaryDiamond

' Classe di associazione collegata al rombo tramite linea tratteggiata
class Fornitura {
    - quantita: int
    - data: Date
}

TernaryDiamond .. Fornitura
@enduml